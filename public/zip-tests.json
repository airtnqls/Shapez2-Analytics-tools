      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Crystal Chain Destruction)",
      "operation": "destroy_half",
      "input_a": "crcrSrSr:CucucuCu",
      "expected_a": "S---",
      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Single Pin Layer Creation)",
      "operation": "destroy_half",
      "input_a": "P-P-P-P-:cucucucu",
      "expected_a": "PP--",
      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Crystal Avoidance)",
      "operation": "destroy_half",
      "input_a": "SrcrSrcr:cucuCuCu",
      "expected_a": "Sc--:cc--",
      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Advanced - Gap:Shape:Crystal)",
      "operation": "destroy_half",
      "input_a": "cwCuCucw:CuCuCuCu:crCuCuCu",
      "expected_a": "-S--:SS--:cS--",
      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Advanced - Gap:Shape:Crystal Failure)",
      "operation": "destroy_half",
      "input_a": "cwcwcwcw:cwCuCuCu:CuCuCuCu:crCuCuCu",
      "expected_a": "-S--:SS--:-S--",
      "expected_b": ""
    },
    {
      "name": "Half Destroyer (Advanced - Shape:Gap:Crystal)",
      "operation": "destroy_half",
      "input_a": "Su--Cu--:P-CuCu--:CucrCu--",
      "expected_a": "SS--:P---:Sc--",
      "expected_b": ""
    },
    {
