{
  "test.category.physics_basic": [
    {
      "name": "Basic Gravity",
      "operation": "apply_physics",
      "input_a": "--------:CuCuCuCu",
      "expected_a": "SSSS",
      "expected_b": ""
    },
    {
      "name": "Basic Gravity (Ignore Middle)",
      "operation": "apply_physics",
      "input_a": "P---P---:----P---:----cr--:--Cu--Cu",
      "expected_a": "PSPS:--P-:--c-",
      "expected_b": ""
    },
    {
      "name": "Pin Support (Success)",
      "operation": "apply_physics",
      "input_a": "P-P-P-P-:crcrcrcr",
      "expected_a": "PPPP:cccc",
      "expected_b": ""
    },
    {
      "name": "Pin Support (Failure & Chain Destruction)",
      "operation": "apply_physics",
      "input_a": "----P-P-:--crcr--",
      "expected_a": "--PP:-cc-",
      "expected_b": ""
    },
    {
      "name": "Crystal Fall",
      "operation": "apply_physics",
      "input_a": "--------:crcrcrcr",
      "expected_a": "",
      "expected_b": ""
    },
    {
      "name": "Simple Fall",
      "operation": "apply_physics",
      "input_a": "--------:cr------",
      "expected_a": "",
      "expected_b": ""
    },
    {
      "name": "Crystal Collision",
      "operation": "apply_physics",
      "input_a": "cr------:crcrcrcr:--------:cr------",
      "expected_a": "c---:cccc",
      "expected_b": ""
    },
    {
      "name": "Pin Support Test",
      "operation": "apply_physics",
      "input_a": "P-------:P-------:P-----cr:crcrcrcr",
      "expected_a": "P---:P---:P--c:cccc",
      "expected_b": ""
    },
    {
      "name": "Pin Support Test2",
      "operation": "apply_physics",
      "input_a": "cr------:P-------:------cr:crcrcrcr",
      "expected_a": "c---:P---",
      "expected_b": ""
    },
    {
      "name": "Complex Test",
      "operation": "apply_physics",
      "input_a": "cw------:P-crRg--",
      "expected_a": "c-S-:P---",
      "expected_b": ""
    },
    {
      "name": "Complex Test2",
      "operation": "apply_physics",
      "input_a": "------Cu:CuCu--P-",
      "expected_a": "SS-S:---P",
      "expected_b": ""
    },
    {
      "name": "Complex Test3",
      "operation": "apply_physics",
      "input_a": "--Cu----:--------:RuRu----",
      "expected_a": "-S--:SS--",
      "expected_b": ""
    },
    {
      "name": "Complex Test3",
      "operation": "apply_physics",
      "input_a": "--------:--Cu----:--------:P-Ru----",
      "expected_a": "PS--:-S--",
      "expected_b": ""
    },
    {
      "name": "Hybrid physics",
      "operation": "apply_physics",
      "input_a": "-P--:-S--:--SS:---S:-SS-",
      "expected_a": "-PSS:-S-S:-SS-",
      "expected_b": ""
    }
  ],
  "test.category.building_functions": [
    {
      "name": "Half Destroyer",
